<?xml version="1.0" encoding="utf-8"?>
<!-- 明文流量全部禁用（PRD-ui 3.6 节 AC-UI-21-5），用户安装的证书也不信任。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
